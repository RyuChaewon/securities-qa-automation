        "purpose": "공개 예제용 가상 테스트 계좌"
      },
      "inputMode": "Prefilled"
    }
  ],
  "defaultLocators": {
    "account": [
      { "controlType": "Edit", "nameRegex": "계좌|Account", "relativeRegion": "top" },
      { "controlType": "ComboBox", "nameRegex": "계좌|Account", "relativeRegion": "top" },
      { "className": "Edit", "controlType": "Edit", "relativeRegion": "top", "ordinal": 0 },
      { "className": "ComboBox", "controlType": "ComboBox", "relativeRegion": "top", "ordinal": 0 }
    ],
    "password": [
      { "controlType": "Edit", "nameRegex": "비밀번호|Password|PIN", "relativeRegion": "top" },
      { "className": "Edit", "controlType": "Edit", "relativeRegion": "top", "ordinal": 1 }
    ],
    "query": [
      { "controlType": "Button", "nameRegex": "^조회$|조회하기|Search|Query", "relativeRegion": "top" }
    ]
  },
